{
  "name": "Raw lead in water poisons a player standing in the water beside it",
  "gamemode": "survival",
  "steps": [
    { "fill": [-3, 0, -3], "to": [3, 0, 3], "block": "minecraft:stone" },
    { "fill": [-2, 0, -2], "to": [2, 0, 2], "block": "minecraft:air" },
    { "setblock": [0, 0, 0], "block": "theleadage:raw_lead_block" },
    { "fill": [-2, 0, -2], "to": [2, 0, -1], "block": "minecraft:water" },
    { "fill": [-2, 0, 1], "to": [2, 0, 2], "block": "minecraft:water" },
    { "fill": [-2, 0, 0], "to": [-1, 0, 0], "block": "minecraft:water" },
    { "fill": [1, 0, 0], "to": [2, 0, 0], "block": "minecraft:water" },
    { "expect": "block", "at": [0, 0, 0], "is": "theleadage:raw_lead_block", "with": { "contamination": "1" }, "within": 20 },
    { "move": [2, 0, 0] },
    { "expect": "effect", "has": "minecraft:hunger", "within": 600 },
    { "move": [0, 0, -5] },
    { "look": [0, 0, 0] },
    { "wait": 40 },
    { "screenshot": "tinted-water" }
  ]
}
