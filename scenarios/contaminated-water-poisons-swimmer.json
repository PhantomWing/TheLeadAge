{
  "name": "Raw lead in water poisons a player standing in the water beside it",
  "gamemode": "survival",
  "steps": [
    { "fill": [-3, -2, -3], "to": [3, -2, 3], "block": "minecraft:stone" },
    { "setblock": [0, -2, 0], "block": "theleadage:raw_lead_block" },
    { "fill": [-2, -1, -2], "to": [2, -1, 2], "block": "minecraft:water" },
    { "expect": "block", "at": [0, -2, 0], "is": "theleadage:raw_lead_block", "with": { "contamination": "1" }, "within": 20 },
    { "move": [2, -1, 0] },
    { "expect": "effect", "has": "minecraft:hunger", "within": 600 },
    { "move": [0, 0, -4] },
    { "look": [0, -1, 0] },
    { "wait": 40 },
    { "screenshot": "tinted-water" }
  ]
}
