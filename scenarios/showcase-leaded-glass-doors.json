{
  "name": "A leaded glass double door shows one design on both doors, closed and open, and the trapdoor's swings with it",
  "gamemode": "creative",
  "steps": [
    { "move": [0, 0, -2] },
    { "hold": "theleadage:leaded_glass_door[theleadage:leaded_glass_door_config={top:{frame:\"diagonal_a\",colors:[14,-1]},bottom:{frame:\"diagonal_a\",colors:[14,-1]}}]" },
    { "use": [0, -1, 0], "face": "up" },
    { "use": [-1, -1, 0], "face": "up" },
    { "hold": "theleadage:leaded_glass_trapdoor[theleadage:leaded_glass_config={frame:\"diagonal_a\",colors:[14,-1]}]" },
    { "use": [3, -1, 0], "face": "up" },
    { "expect": "block", "at": [0, 1, 0], "is": "theleadage:leaded_glass_door", "with": { "facing": "south", "hinge": "left" } },
    { "expect": "block", "at": [-1, 1, 0], "is": "theleadage:leaded_glass_door", "with": { "facing": "south", "hinge": "right" } },
    { "expect": "block", "at": [3, 0, 0], "is": "theleadage:leaded_glass_trapdoor", "with": { "facing": "north", "half": "bottom" } },
    { "hold": "minecraft:air" },
    { "move": [0, 0, -4] },
    { "look": [0, 1, 0] },
    { "screenshot": "double-door-closed" },
    { "move": [3, 0, -2] },
    { "look": [3, 0, 0] },
    { "screenshot": "trapdoor-closed" },
    { "use": [3, 0, 0], "face": "up" },
    { "move": [0, 0, -2] },
    { "use": [-1, 0, 0], "face": "north" },
    { "use": [0, 0, 0], "face": "north" },
    { "expect": "block", "at": [0, 0, 0], "with": { "open": "true" } },
    { "expect": "block", "at": [-1, 0, 0], "with": { "open": "true" } },
    { "expect": "block", "at": [3, 0, 0], "with": { "open": "true" } },
    { "move": [0, 0, -3] },
    { "look": [0, 1, 2] },
    { "screenshot": "double-door-open" },
    { "move": [3, 0, -3] },
    { "look": [3, 1, 0] },
    { "screenshot": "trapdoor-open" }
  ]
}
