{
  "schemaVersion": 1,
  "id": "theleadage",
  "version": "${version}",
  "name": "The Lead Age",
  "description": "A vanilla-friendly expansion that adds lead, a new metal resource. A sister mod to The Silver Age.",
  "authors": [
    "PhantomWing"
  ],
  "contact": {
    "homepage": "https://github.com/PhantomWing/TheLeadAge",
    "sources": "https://github.com/PhantomWing/TheLeadAge",
    "issues": "https://github.com/PhantomWing/TheLeadAge/issues"
  },
  "license": "MIT License",
  "icon": "assets/theleadage/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.phantomwing.theleadage.fabric.TheLeadAgeFabric"
    ],
    "client": [
      "com.phantomwing.theleadage.fabric.client.TheLeadAgeFabricClient"
    ],
    "jei_mod_plugin": [
      "com.phantomwing.theleadage.compat.jei.TheLeadAgeJeiPlugin"
    ]
  },
  "mixins": [
    "theleadage.mixins.json"
  ],
  "depends": {
    "fabricloader": "${dep_fabricloader}",
    "fabric-api": "${dep_fabric_api}",
    "minecraft": "${dep_minecraft_fabric}",
    "architectury": "${dep_architectury_fabric}",
    "cloth-config": "${dep_cloth}"
  },
  "suggests": {
    "farmersdelight": "*",
    "jei": "*"
  }
}
